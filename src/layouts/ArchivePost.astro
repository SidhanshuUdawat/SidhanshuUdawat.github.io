---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: string;
  tags: string;
  description: string;
  canonicalPath: string;
}

const { title, date, tags, description, canonicalPath } = Astro.props;
---

<BaseLayout
  title={`${title} | Sidhanshu Udawat`}
  description={description}
  canonicalPath={canonicalPath}
  article
>
  <main id="content" class="article-page">
    <a class="article-back" href="/pensieve/">← Pensieve archive</a>
    <article>
      <header class="article-header">
        <p class="section-kicker">Archived note · {tags}</p>
        <h1>{title}</h1>
        <p>{date}</p>
      </header>
      <div class="article-body">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>
