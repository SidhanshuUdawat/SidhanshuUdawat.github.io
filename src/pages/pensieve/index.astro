---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = [
  {
    title: 'Docker Compose Error',
    date: '13 December 2019',
    tags: 'WordPress · Docker',
    href: '/pensieve/docker-error/',
    description: 'A short note on resolving an unsupported Docker Compose workdir API error.',
  },
  {
    title: 'WordPress Publishing Error',
    date: '3 December 2019',
    tags: 'WordPress',
    href: '/pensieve/wordpress-publish-error/',
    description: 'Tracing an invalid JSON response in WordPress back to a local HTTPS mismatch.',
  },
  {
    title: 'Markdown Test File',
    date: '7 December 2019',
    tags: 'Testing',
    href: '/pensieve/markdown-playground/',
    description: 'An archived formatting and syntax-highlighting test from the original site.',
  },
];
---

<BaseLayout
  title="Pensieve Archive | Sidhanshu Udawat"
  description="Archived technical notes by Sidhanshu Udawat."
  canonicalPath="/pensieve/"
>
  <main id="content" class="archive-page">
    <header class="archive-header">
      <p class="section-kicker">Archive · 2019</p>
      <h1>Pensieve</h1>
      <p>
        Older technical notes from a previous version of this site, preserved at their original URLs.
      </p>
    </header>
    <div class="archive-list">
      {posts.map((post, index) => (
        <a class="archive-item" href={post.href}>
          <span>0{index + 1}</span>
          <div>
            <p>{post.date} · {post.tags}</p>
            <h2>{post.title}</h2>
            <p>{post.description}</p>
          </div>
          <span aria-hidden="true">→</span>
        </a>
      ))}
    </div>
    <a class="text-link" href="/">← Return home</a>
  </main>
</BaseLayout>
